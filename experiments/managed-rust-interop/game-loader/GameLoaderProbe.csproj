<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>AIAscensionSTS2GameMod</AssemblyName>
    <RootNamespace>AiAscension.Sts2GameMod.Runtime</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$(MSBuildProjectDirectory)=/_/sts2-game-mod/game-loader</PathMap>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!-- The legacy room-entry combat fixture must never ship in a production addon. -->
  <PropertyGroup Condition="'$(EnableCombatDemoProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);STS2_COMBAT_DEMO_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="LiveCombatFixture.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableCombatDemoProbe)' == 'true'">
    <Compile Include="LiveCombatFixture.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(EnableVideoMenuProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);STS2_VIDEO_MENU_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableVideoMenuProbe)' == 'true'">
    <Compile Include="../video-host-probe/VideoMenuProbe.cs" Link="VideoMenuProbe.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(EnableHandChoiceProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);STS2_HAND_CHOICE_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableHandChoiceProbe)' == 'true'">
    <Compile Include="../hand-host-probe/HandChoiceProbe.cs" Link="HandChoiceProbe.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(EnableTerminalProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);STS2_TERMINAL_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableTerminalProbe)' == 'true'">
    <Compile Include="../terminal-host-probe/TerminalProbe.cs" Link="TerminalProbe.cs" />
  </ItemGroup>

  <!-- The production native session controller is part of the addon. Observation output remains
       an operator diagnostic fixture and is included only when explicitly requested. -->
  <PropertyGroup Condition="'$(EnableNativeCoopProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);STS2_NATIVE_COOP_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="CoopNativeLobbyProbe.cs;CoopNativeLobbyProbe.Support.cs;CoopNativeLobbyProbe.Diagnostics.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableNativeCoopProbe)' == 'true'">
    <Compile Include="CoopNativeLobbyProbe.cs" />
    <Compile Include="CoopNativeLobbyProbe.Support.cs" />
    <Compile Include="CoopNativeLobbyProbe.Diagnostics.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(STS2GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateHostAssemblyPath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(STS2GameDataDir)' == ''"
           Text="Set STS2GameDataDir to the directory containing sts2.dll." />
    <Error Condition="'$(STS2GameDataDir)' != '' and !Exists('$(STS2GameDataDir)/sts2.dll')"
           Text="STS2GameDataDir does not contain sts2.dll: $(STS2GameDataDir)" />
  </Target>
</Project>
