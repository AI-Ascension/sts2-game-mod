<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(STS2GameDataDir)/sts2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDataDir)/GodotSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="../game-loader/RuntimeV3GameplayContract.cs" Link="RuntimeV3GameplayContract.cs" />
    <Compile Include="../game-loader/CoopHostContracts.cs" Link="CoopHostContracts.cs" />
    <Compile Include="../game-loader/CoopHostContracts.Requests.cs" Link="CoopHostContracts.Requests.cs" />
    <Compile Include="../game-loader/CoopNativeLegalCatalog.cs" Link="CoopNativeLegalCatalog.cs" />
    <Compile Include="../game-loader/CoopNativeLobbyAdmission.cs" Link="CoopNativeLobbyAdmission.cs" />
    <Compile Include="../game-loader/InstalledNativeCoopSynchronizers.cs" Link="InstalledNativeCoopSynchronizers.cs" />
    <Compile Include="../game-loader/InstalledNativeCoopSynchronizers.*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../game-loader/NativeCoopPeerLiveness.cs" Link="NativeCoopPeerLiveness.cs" />
    <Compile Include="../game-loader/NativeCoopAttemptWindow.cs" Link="NativeCoopAttemptWindow.cs" />
    <Compile Include="../game-loader/NativeCoopSessionController*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../game-loader/InstalledNativeCoopHostPort*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../game-loader/CoopNativeEncoding.cs" Link="CoopNativeEncoding.cs" />
    <Compile Include="../game-loader/CoopNativeEncoding.PlayerChoice.cs" Link="CoopNativeEncoding.PlayerChoice.cs" />
  </ItemGroup>
  <Target Name="ValidateHostAssemblyPath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(STS2GameDataDir)' == ''" Text="Set STS2GameDataDir to the directory containing sts2.dll." />
    <Error Condition="'$(STS2GameDataDir)' != '' and !Exists('$(STS2GameDataDir)/sts2.dll')" Text="STS2GameDataDir does not contain sts2.dll: $(STS2GameDataDir)" />
  </Target>
</Project>
