<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <OutputPath>bin/LaunchContractProbe/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/LaunchContractProbe/$(Configuration)/</IntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LaunchContractRefusalProbe.cs" />
    <Compile Include="../game-loader/LaunchContractRefusal.cs" Link="Boundary/LaunchContractRefusal.cs" />
    <Compile Include="../game-loader/IsolatedUserDirectoryCheck.cs" Link="Boundary/IsolatedUserDirectoryCheck.cs" />
    <Compile Include="../game-loader/RuntimeV3Gameplay*.cs" Exclude="../game-loader/RuntimeV3GameplayInterop.cs" Link="Boundary/%(Filename)%(Extension)" />
    <Compile Include="../game-loader/LegalActionCatalog.cs" Link="Boundary/LegalActionCatalog.cs" />
    <Compile Include="../game-loader/PostconditionVerifier.cs" Link="Boundary/PostconditionVerifier.cs" />
    <Compile Include="../game-loader/FairPlayProjection.cs" Link="Boundary/FairPlayProjection.cs" />
    <Compile Include="../game-loader/PrivilegedFieldGuard.cs" Link="Boundary/PrivilegedFieldGuard.cs" />
    <Compile Include="../game-loader/LlmCombatPatch.cs" Link="Boundary/LlmCombatPatch.cs" />
    <Compile Include="../game-loader/StateDetector.cs" Link="Boundary/StateDetector.cs" />
    <Compile Include="../game-loader/BuildManifest.cs" Link="Boundary/BuildManifest.cs" />
    <!-- The source-only gameplay projection the refusal answer is rendered through. -->
    <Compile Include="../game-loader/CoopProjection.cs" Link="Boundary/CoopProjection.cs" />
    <Compile Include="../game-loader/CoopSynchronization.cs" Link="Boundary/CoopSynchronization.cs" />
  </ItemGroup>
</Project>
